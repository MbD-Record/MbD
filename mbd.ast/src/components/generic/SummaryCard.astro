---
interface Props {
  title: string;
  description: string;
  variant?: 'blog' | string;
}

const { title, description, variant = '1' } = Astro.props;
---

<div class={`mbd-card mbd-card--${variant}`}>
  <h3 class='poppins text-base md:text-xl leading-tight'>{title}</h3>
  <p class='poppins mt-2 md:mt-4 text-sm md:text-base leading-snug'>{description}</p>
  <slot />
</div>