---
import { getCollection } from 'astro:content';
import BlogList from '../blog/BlogList.astro';
import { byYearDesc } from '../../lib/entries';

const posts = (await getCollection('blog')).sort(byYearDesc);
---

<section class='mt-8'>
  <div class='mbd-card mbd-card--4'>
    <h2 class='text-3xl md:text-5xl lg:text-7xl mb-8 outfit'>Years</h2>
    <BlogList posts={posts} />
  </div>
</section>