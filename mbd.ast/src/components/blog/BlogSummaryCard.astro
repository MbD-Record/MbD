---
import type { CollectionEntry } from 'astro:content';
import SummaryCard from '../generic/SummaryCard.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const currentYear = new Date().getFullYear();
const isCurrentYear = Number(post.slug) === currentYear;
const label = post.data.buttonLabel ?? `Check out ${post.slug}`;
---

<SummaryCard
  title={post.data.title}
  description={isCurrentYear ? 'Currently ongoing' : post.data.description}
  variant='blog'
>
  <div class='mt-3 md:mt-4 md:flex md:justify-end'>
    <a class='mbd-btn mbd-btn--compact text-sm md:text-base' href={`/blog/${post.slug}/`}>{label} &rarr;</a>
  </div>
</SummaryCard>