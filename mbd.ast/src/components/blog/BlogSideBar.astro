---
import { getCollection } from 'astro:content';
import { byYearDesc } from '../../lib/entries';

interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
const currentSlug = Astro.params.slug;

const entries = (await getCollection('blog')).sort(byYearDesc);

// The sidebar is a month index, so it lists months and nothing else.
//
// Filtering on depth alone is not enough: backlog pages such as 2017 have no
// months and instead put Albums / Tracks / Lists directly at depth 2, which
// would otherwise show up here pretending to be months. Matching the heading
// text against the month names handles that without naming any page, so a
// backlog page simply contributes nothing.
const MONTHS = [
  'january', 'february', 'march', 'april', 'may', 'june',
  'july', 'august', 'september', 'october', 'november', 'december',
];

// A heading counts as a month when every part of it is one, so combined
// headings like "September / October" or a trailing year like "January 2023"
// both resolve. Anything else -- "Albums", "Tracks", "Lists" on a backlog
// page -- is skipped.
const isMonth = (text: string) => {
  const cleaned = text
    .trim()
    .toLowerCase()
    .replace(/\s*\d{4}\s*$/, '')
    .trim();
  return cleaned.length > 0 && cleaned.split(/[\/\-–&]/).every((part) => MONTHS.includes(part.trim()));
};

const months = headings.filter((h) => h.depth === 2 && isMonth(h.text));
---

<aside>
  <nav class='hidden lg:block sticky top-6'>
    <ul>
      {
        entries.map((entry) => {
          const isCurrent = entry.slug === currentSlug;
          return (
            <li class='py-1'>
              <a
                class:list={[
                  'transition-all duration-150 ease-in-out text-dark poppins hover:underline',
                  isCurrent && 'font-bold',
                ]}
                href={`/blog/${entry.slug}/`}
              >
                {entry.data.title}
              </a>
              {isCurrent && months.length > 0 && (
                <ul>
                  {months.map((heading) => (
                    <li class='py-1 pl-4'>
                      <a
                        class='font-bold transition-all duration-150 ease-in-out text-dark poppins hover:underline'
                        href={`#${heading.slug}`}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>