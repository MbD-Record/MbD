---
import BlogSummaryCard from './BlogSummaryCard.astro';

interface Props {
  posts: import('astro:content').CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class='grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-8'>
  {
    posts.map((post) => {
      return (
        <li>
          <BlogSummaryCard post={post} />
        </li>
      );
    })
  }
</ul>