---
/**
 * Preview of 2026 rendered through the Release component.
 *
 * Reads the real src/content/blog/2026.md and parses it the way the eventual
 * render pipeline will: H2 is a month, H3 is a section, and every entry is a
 * "[Artist - Album](url)" line with an optional tracking note.
 *
 *   npm run dev   ->   http://localhost:4321/2026-test
 */
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Default.astro';
import Release from '../components/blog/Release.astro';
import { artwork } from '../lib/artwork';

if (import.meta.env.PROD) {
  return Astro.redirect('/');
}

const SRC = path.resolve('src/content/blog/2026.md');
const raw = fs.readFileSync(SRC, 'utf8').replace(/^\uFEFF/, '').split(/\r?\n/);

type Entry = { label: string; url: string; note?: string; artist: string; album: string };
type Block = { heading: string; entries: Entry[] };

const months: { name: string; blocks: Block[] }[] = [];
let curMonth: (typeof months)[number] | null = null;
let curBlock: Block | null = null;
let inComment = false;
let skipped: string[] = [];

for (const line of raw) {
  const s = line.trim();
  if (!inComment && s.startsWith('<!--')) { inComment = true; continue; }
  if (inComment) { if (s.endsWith('-->')) inComment = false; continue; }

  const h = s.match(/^(#{1,3})\s+(.+)$/);
  if (h) {
    const depth = h[1].length;
    const text = h[2].trim();
    if (depth === 1) continue;
    if (depth === 2) {
      curMonth = { name: text, blocks: [] };
      months.push(curMonth);
      curBlock = null;
    } else if (depth === 3 && curMonth) {
      curBlock = { heading: text, entries: [] };
      curMonth.blocks.push(curBlock);
    }
    continue;
  }

  if (!s || !curBlock) continue;

  const m = s.match(/^\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)(?:\s*\*([^*]+)\*)?\s*$/);
  if (m) {
    const label = m[1];
    const sep = label.indexOf(' - ');
    curBlock.entries.push({
      label,
      url: m[2],
      note: m[3]?.trim(),
      artist: sep === -1 ? label : label.slice(0, sep),
      album: sep === -1 ? '' : label.slice(sep + 3),
    });
    continue;
  }
  skipped.push(s);
}

const all = months.flatMap((m) => m.blocks.flatMap((b) => b.entries));
const withArt = all.filter((e) => artwork[e.url]?.art).length;
const missing = all.filter((e) => !artwork[e.url]?.art);
const withNote = all.filter((e) => e.note);

const tiles = ['mbd-card--1', 'mbd-card--2', 'mbd-card--3', 'mbd-card--4', 'mbd-card--5'];
---

<Layout title="2026 test" description="2026 rendered through the Release component">
  <main class="mbd-page p-6">
    <div class="mx-auto max-w-3xl">
      <header class="mb-8">
        <h1 class="mb-2 text-3xl font-bold">2026 through Release</h1>
        <p class="mb-2 text-sm">
          Parsed from the real <code>src/content/blog/2026.md</code> — the same
          structure the real pipeline will use. <strong>{all.length}</strong>
          entries, <strong>{withArt}</strong> with cover art,
          <strong>{withNote.length}</strong> carrying a tracking note.
        </p>
        <p class="text-sm">
          Cover art comes from Bandcamp first (the link's own page), then the
          Cover Art Archive / iTunes / Deezer fallbacks. Everything resolves
          from the committed cache, so nothing is fetched at page load.
        </p>
      </header>

      {
        months.map((month, mi) => (
          <section class={`mb-8 mb-card ${tiles[mi % tiles.length]} p-4`}>
            <h2 class="mb-3 text-xl font-bold">{month.name}</h2>
            {month.blocks.map((block) => (
              <div class="mb-4 last:mb-0">
                <h3 class="mb-2 text-xs font-bold uppercase tracking-widest opacity-70">
                  {block.heading}
                </h3>
                <div class="flex flex-col gap-1.5">
                  {block.entries.map((e) => (
                    <Release
                      url={e.url}
                      artist={e.artist}
                      album={e.album}
                      note={e.note}
                    />
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))
      }

      {
        missing.length > 0 && (
          <section class="mb-8">
            <h2 class="mb-2 text-lg font-bold">
              Falling back to a monogram ({missing.length})
            </h2>
            <ul class="mbd-card mbd-card--blog p-3 text-sm">
              {missing.map((e) => (
                <li class="py-0.5">
                  <code class="text-xs opacity-60">{e.url}</code>
                  <br />
                  {e.label}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        skipped.length > 0 && (
          <section class="mb-8">
            <h2 class="mb-2 text-lg font-bold">Lines not parsed as entries</h2>
            <ul class="mbd-card mbd-card--blog p-3 text-sm">
              {skipped.map((s) => (
                <li class="py-0.5">{s}</li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2 class="mb-2 text-lg font-bold">How each entry parsed</h2>
        <ul class="mbd-card mbd-card--blog p-3 text-sm">
          {
            all.map((e) => (
              <li class="py-1">
                <strong>{e.artist}</strong>
                {e.album && <span> — {e.album}</span>}
                <br />
                <code class="text-xs opacity-60">{e.url}</code>
                {e.note && <span class="opacity-60"> · {e.note}</span>}
                <span class="text-xs opacity-50">
                  {' '}
                  {artwork[e.url]?.art ? '· art' : '· monogram'}
                  {artwork[e.url]?.audio ? ' · audio' : ''}
                </span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Layout>