---
/**
 * Dev-only lab page for the artwork/metadata idea.
 *
 * Astro ignores files prefixed with `_`, so that convention cannot be used
 * here — those pages are unroutable in dev as well as in the build. This page
 * is therefore routed normally but bounces to the homepage if it is ever
 * reached from a production build. Delete the file once the idea is settled.
 *
 *   npm run dev   ->   http://localhost:4321/artlab
 */
import Layout from '../layouts/Default.astro';
import { artwork } from '../lib/artwork';

if (import.meta.env.PROD) {
  return Astro.redirect('/');
}

const entries = Object.values(artwork).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const matched = entries.filter((e) => e.art).length;

// Keep the card colours varied without disturbing the runtime palette.
const tiles = ['mbd-card--1', 'mbd-card--2', 'mbd-card--3', 'mbd-card--4', 'mbd-card--5'];
---

<Layout title="Artwork lab" description="Preview of enriched release data">
  <main class="mbd-page p-6">
    <div class="mx-auto max-w-6xl">
      <header class="mb-6">
        <h1 class="mb-2 text-3xl font-bold">Artwork lab</h1>
        <p class="mb-4">
          <strong>{matched}</strong> of <strong>{entries.length}</strong> matched a
          catalogue. Everything here is read from a committed JSON cache, so
          there is no request at page load.
        </p>
        <p class="text-sm">
          Covers come from Cover Art Archive where MusicBrainz has a release,
          otherwise iTunes or Deezer. Previews are 30-second samples from
          iTunes. <strong>Bandcamp is never queried</strong> — its oEmbed is
          dead and its pages sit behind a bot wall, so the artist and album
          text already in the post is matched against third-party catalogues
          instead.
        </p>
      </header>

      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          entries.map((entry, i) => (
            <li class={`mbd-card ${tiles[i % tiles.length]} flex flex-col gap-3`}>
              {entry.art ? (
                <img
                  class="aspect-square w-full border-2 border-black object-cover"
                  src={entry.art}
                  alt={`Cover art for ${entry.artist}${entry.album ? ` — ${entry.album}` : ''}`}
                  loading="lazy"
                />
              ) : (
                <div class="flex aspect-square w-full items-center justify-center border-2 border-dashed border-black p-4 text-center">
                  <span class="font-bold">
                    {entry.artist}
                    {entry.album ? <><br />{entry.album}</> : null}
                    <br />
                    <span class="text-xs font-normal">no catalogue match</span>
                  </span>
                </div>
              )}

              <div>
                <p class="font-bold leading-tight">{entry.artist}</p>
                {entry.album && <p class="leading-tight">{entry.album}</p>}
              </div>

              <div class="text-xs">
                {entry.match?.genre && <p>Genre: {entry.match.genre}</p>}
                {entry.match?.year && <p>Released: {entry.match.year}</p>}
                <p>
                  via {entry.match?.source ?? '—'}
                  {entry.match?.score != null && (
                    <span> ({(entry.match.score * 100).toFixed(0)}% match)</span>
                  )}
                </p>
                <p class="mt-1">
                  <a class="underline" href={entry.url} target="_blank" rel="noopener">
                    original link &rarr;
                  </a>
                </p>
              </div>

              {entry.audio && (
                <div class="mt-auto">
                  <button
                    class="mbd-btn mbd-btn--compact preview-btn"
                    data-src={entry.audio}
                    data-label={`${entry.artist}${entry.album ? ` — ${entry.album}` : ''}`}
                  >
                    &#9654;&ensp;Play 30s
                  </button>
                  <audio class="preview-audio" preload="none"></audio>
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <p class="mt-8 text-sm">
        A miss here usually means the release is simply not on iTunes or Deezer
        — those catalogues skew towards major-label and DSP-distributed
        releases, so independent Bandcamp-only records are the ones that drop
        out. Those should fall back to the plain text link.
      </p>
    </div>
  </main>

  <script>
    // One shared player: starting a new sample stops whatever was playing.
    let current: HTMLAudioElement | null = null;
    let currentBtn: HTMLButtonElement | null = null;

    function stop() {
      current?.pause();
      if (currentBtn) currentBtn.innerHTML = '&#9654;&ensp;Play 30s';
      current = null;
      currentBtn = null;
    }

    document.querySelectorAll<HTMLButtonElement>('.preview-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (currentBtn === btn) return stop();

        stop();

        const audio = btn.parentElement?.querySelector('audio') as HTMLAudioElement;
        audio.src = btn.dataset.src!;
        audio.play().catch(() => {
          btn.textContent = 'preview blocked';
        });

        current = audio;
        currentBtn = btn;
        btn.innerHTML = '&#10073;&#10073;&ensp;Stop';
        btn.dataset.label = btn.dataset.label!;

        audio.onended = stop;
      });
    });
  </script>
</Layout>