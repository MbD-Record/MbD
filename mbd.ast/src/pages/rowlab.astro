---
/**
 * Dev-only lab for the compact release row and the month/section structure.
 *
 *   npm run dev   ->   http://localhost:4321/rowlab
 *
 * Delete once the format is settled.
 */
import Layout from '../layouts/Default.astro';
import Release from '../components/blog/Release.astro';
import { artwork } from '../lib/artwork';

if (import.meta.env.PROD) {
  return Astro.redirect('/');
}

const bc = Object.values(artwork).filter((e) => e.art);
const hit = (u: string) => artwork[u];

const comparison = [
  { url: 'https://dancewiththedead.bandcamp.com/album/the-shape', artist: 'Dance With the Dead', album: 'The Shape' },
  { url: 'https://chontheband.bandcamp.com/album/chon', artist: 'CHON', album: 'CHON' },
  { url: 'https://teethofthesea.bandcamp.com/album/wraith', artist: 'Teeth of the Sea', album: 'Wraith' },
  { url: 'https://www.youtube.com/watch?v=dPlX2_avXZA', artist: 'PlumBlossom', album: '失われた街' },
  { url: 'https://bloodincantation.bandcamp.com/album/absolute-truth', artist: 'Blood Incantation', album: 'Absolute Truth' },
];

// A real month from 2021, split the way the posts will be structured.
const month = {
  albums: [
    { url: 'https://soulglophl.bandcamp.com/album/live-wkdu', artist: 'Soul Glo', album: 'Live @ WKDU' },
    { url: 'https://wakegrind.bandcamp.com/album/devouring-ruin', artist: 'Wake', album: 'Devouring Ruin' },
    { url: 'https://elephant-gym.bandcamp.com/album/underwater', artist: 'Elephant Gym', album: 'Underwater' },
  ],
  tracks: [
    { url: 'https://slothrust.bandcamp.com/album/parallel-timeline', artist: 'Slothrust', album: 'Parallel Timeline' },
    { url: 'https://kinkajous.bandcamp.com/album/nothing-will-disappear', artist: 'Kinkajous', album: 'Nothing Will Disappear' },
  ],
  lists: [
    { url: 'https://kryptox-music.bandcamp.com/album/mathias-modica-presents-kraut-jazz-futurism-vol-2', artist: 'Kraut Jazz Futurism Vol. 2' },
    { url: 'https://contrasttrio.bandcamp.com/album/letila-zozulya', artist: 'Contrast Trio', album: 'Letila Zozulya' },
  ],
};
---

<Layout title="Row lab" description="Preview of the compact release row">
  <main class="mbd-page p-6">
    <div class="mx-auto max-w-4xl">
      <header class="mb-8">
        <h1 class="mb-2 text-3xl font-bold">Compact release row</h1>
        <p class="text-sm">
          38px thumbnail, rounded to match the rest of the design, 2px outline,
          6px between rows. Two border treatments to compare. Thumbnails come
          from the video id for YouTube and from the committed artwork cache
          for everything else; unresolved entries fall back to a monogram.
        </p>
      </header>

      <section class="mb-10 grid gap-8 md:grid-cols-2">
        <div>
          <h2 class="mb-3 text-lg font-bold">Plain outline</h2>
          <div class="flex flex-col gap-1.5">
            {comparison.map((d) => <Release {...d} />)}
          </div>
        </div>
        <div>
          <h2 class="mb-3 text-lg font-bold">Offset border</h2>
          <div class="flex flex-col gap-2">
            {comparison.map((d) => <Release {...d} border='offset' />)}
          </div>
        </div>
      </section>

      <section class="mb-10">
        <h2 class="mb-1 text-2xl font-bold">March</h2>
        <p class="mb-4 text-sm opacity-70">
          H2 is the month and is what the sidebar lists. The three H3 blocks
          below are for orientation inside the month and are filtered out of the
          sidebar, so it stays a flat list of months.
        </p>

        <h3 class="mb-2 text-base font-bold uppercase tracking-wide">Albums</h3>
        <div class="mb-5 flex flex-col gap-1.5">
          {month.albums.map((d) => <Release {...d} />)}
        </div>

        <h3 class="mb-2 text-base font-bold uppercase tracking-wide">Tracks</h3>
        <div class="mb-5 flex flex-col gap-1.5">
          {month.tracks.map((d) => <Release {...d} />)}
        </div>

        <h3 class="mb-2 text-base font-bold uppercase tracking-wide">Lists</h3>
        <div class="flex flex-col gap-1.5">
          {month.lists.map((d) => <Release {...d} />)}
        </div>
      </section>

      <section class="mb-10">
        <h2 class="mb-3 text-lg font-bold">Against running text</h2>
        <p class="mb-3 text-sm">
          The outline exists to keep a link findable inside prose. If the rows
          still read as a list here rather than a stack of cards, the size is
          right.
        </p>
        <div class="mb-3 flex flex-col gap-1.5">
          <Release url="https://balkan.taksim.bandcamp.com" artist="Balkan Taksim" />
          <Release url="https://daily.bandcamp.com/2019/06/12/mathcore-guide/" artist="Mathcore feature" />
          <Release url={hit('https://chontheband.bandcamp.com/album/chon')?.url ?? ''} artist="CHON" album="CHON" />
        </div>
        <p class="text-sm">Everything else that month was a distraction.</p>
      </section>

      <section>
        <h2 class="mb-3 text-lg font-bold">Cache coverage</h2>
        <p class="text-sm">
          {bc.length} of {Object.keys(artwork).length} test entries resolved to
          cover art; the rest fall through to the monogram. That ratio is the
          argument for keeping the row border-only rather than designing around
          artwork.
        </p>
      </section>
    </div>
  </main>
</Layout>