---
import Layout from '@layouts/Default.astro';
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import MobileSocials from '@components/home/MobileSocials.astro';

const firstLine = [
  { name: 'Astro', url: 'https://astro.build/' },
  { name: 'Github', url: 'https://github.com/MbD-Record/MbD' },
  { name: 'Cloudflare', url: 'https://www.cloudflare.com/' },
];

const secondLine = [
  {
    name: 'Sitemap',
    url: 'https://docs.astro.build/en/guides/integrations-guide/sitemap/',
  },
  { name: 'RSS', url: 'https://docs.astro.build/en/guides/rss/' },
];

const titleClass = 'text-3xl md:text-5xl lg:text-7xl';
const headingClass = 'text-3xl md:text-5xl lg:text-6xl';
---

<Layout
  title='Home'
  pageTitle='MbD | Home'
  description='A Music Journal'
>
  <main class='mbd-page p-6'>
    <MobileSocials />
    <section id='about' class='grid md:grid-cols-8 gap-8 mt-4 items-stretch'>
      <h2 class='hidden'>About MbD</h2>
      <div class='col-span-4 flex'>
        <div class='mbd-card mbd-card--1 flex flex-col justify-between'>
          <p class={`outfit ${titleClass}`}>
            MbD: Music by Date
          </p>
          <p class='poppins mt-4 text-lg md:text-xl lg:text-3xl'>
            A music list running since 2018.
          </p>
        </div>
      </div>
      <div class='col-span-2 flex'>
        <div class='mbd-card mbd-card--2'>
          <h2 class={`${headingClass} mb-8 outfit`}>
            What?
          </h2>
          <p class='text-lg md:text-xl lg:text-2xl'>
            Music written down for future reference.<br /><br />
            It seemed good at the time.
          </p>
        </div>
      </div>
      <div class='col-span-2 flex'>
        <div class='mbd-card mbd-card--3'>
          <h2 class={`${headingClass} mb-8 outfit`}>
            Why?
          </h2>
          <p class='text-lg md:text-xl lg:text-2xl'>
            To make this list accessible online.<br /><br />
            Links to the music are offered wherever possible.
          </p>
        </div>
      </div>
    </section>
    <RecentBlogPosts />
<section class='grid md:grid-cols-8 gap-8 mt-8'>
      <div class='md:col-start-3 md:col-span-4 flex'>
        <div class='mbd-card mbd-card--5 text-center'>
        <ul class='flex gap-4 flex-wrap justify-center text-lg md:text-xl'>
          {
            firstLine.map((item) => (
              <li>
                <a
                  class='underline'
                  href={item.url}
                  target='_blank'
                  rel='noopener noreferrer'
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class='flex gap-4 flex-wrap justify-center mt-4 text-lg md:text-xl'>
          {
            secondLine.map((item) => (
              <li>
                <a
                  class='underline'
                  href={item.url}
                  target='_blank'
                  rel='noopener noreferrer'
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      </div>
    </section>
  </main>
</Layout>

